# Copy to .env.development or .env for LOCAL DEVELOPMENT & DEV HOSTING
# 
# Environment mode for dev: "development" or "dev"
APP_ENV=development

# Dedicated DEV Supabase project API settings (Project Settings → API).
# Pointing these to a dedicated dev Supabase project isolates dev data from prod.
SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# CORS allow-list for dev (optional, allowed for all when APP_ENV=development)
# CORS_ORIGINS=http://localhost:8081,http://192.168.1.3:8000

# Shared Anthropic / LLM key for testing free questions in development
ANTHROPIC_API_KEY=sk-ant-dev-...

# Optional: free question limit override for development (defaults to 20)
FREE_QUESTION_LIMIT=20

# Optional transactional email keys for dev testing
# SENDGRID_API_KEY=
# FROM_EMAIL=dev-noreply@wisdombase.com
